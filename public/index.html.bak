                                    <i class="fa-solid fa-language text-primary text-xl"></i>
                                    <h3>Language</h3>
                                </div>
                                <div class="setting-item-content">
                                    <div class="form-group" style="margin-top: 0;">
                                        <label style="display:block; margin-bottom: 5px; color: var(--text-muted); font-size: 0.85rem;">Platform Language</label>
                                        <select class="custom-select" style="width:100%; padding: 0.75rem; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: white; border-radius: 0.5rem;">
                                            <option>English</option>
                                            <option>Bangla</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB: PROFILE -->
                <section id="tab-profile" class="tab-content">
                    <header class="topbar" style="margin-bottom: 0.75rem;">
                        <div>
                            <h1 class="page-title text-primary" style="font-size: 1.5rem; margin-bottom: 2px;">User Profile</h1>
                            <p class="subtitle" style="font-size: 0.8rem;">Manage your account and subscription details</p>
                        </div>
                    </header>

                    <div class="profile-grid">
                        <!-- Left column: Avatar and subscription info -->
                        <div class="profile-sidebar">
                            <!-- Avatar Card -->
                            <div class="card avatar-uploader-card" style="padding: 1.25rem 1rem;">
                                <div class="profile-avatar-wrapper">
                                    <img id="profile-avatar-img" class="profile-avatar-img" style="display: none;" src="" alt="Avatar">
                                    <div id="profile-avatar-placeholder" class="profile-avatar-placeholder">U</div>
                                </div>
                                <h3 id="profile-card-name" class="profile-username">User Name</h3>
                                <span id="profile-card-role" class="profile-role-badge">User</span>
                                
                                <div class="avatar-btn-row">
                                    <button class="btn btn-primary" onclick="document.getElementById('avatar-input').click()" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;">
                                        <i class="fa-solid fa-camera"></i> Change
                                    </button>
                                    <button class="btn btn-secondary" id="remove-avatar-btn" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; border-color: var(--danger); color: var(--danger);">
                                        <i class="fa-solid fa-trash-can"></i> Remove
                                    </button>
                                </div>
                                <input type="file" id="avatar-input" accept="image/*" style="display: none;" />
                            </div>

                            <!-- Subscription Card -->
                            <div class="card" style="padding: 1.25rem;">
                                <div class="card-header" style="margin-bottom: 0.5rem; padding-bottom: 0.4rem;">
                                    <i class="fa-solid fa-credit-card text-primary"></i>
                                    <h3>Subscription Details</h3>
                                </div>
                                <div class="plan-details-list">
                                    <div class="plan-detail-row">
                                        <span class="text-muted">Active Plan</span>
                                        <span id="plan-name" class="font-bold">Free Trial</span>
                                    </div>
                                    <div class="plan-detail-row">
                                        <span class="text-muted">Status</span>
                                        <span id="plan-status" class="pill pill-success">Active</span>
                                    </div>
                                    <div class="plan-detail-row">
                                        <span class="text-muted">Valid Until</span>
                                        <span id="plan-expires" class="font-bold">—</span>
                                    </div>
                                </div>
                                <button class="btn btn-primary w-100 mt-3" id="renew-plan-btn" style="background: #0ea5e9; padding: 0.6rem; font-size: 0.85rem;">
                                    <i class="fa-solid fa-arrows-rotate"></i> Renew Subscription
                                </button>
                            </div>
                        </div>

                        <!-- Right column: Edit Details Form -->
                        <div class="card" style="padding: 1.25rem;">
                            <div class="card-header" style="margin-bottom: 0.5rem; padding-bottom: 0.4rem;">
                                <i class="fa-solid fa-user-gear text-primary"></i>
                                <h3>Account Information</h3>
                            </div>
                            <div class="info-field-group">
                                <div class="info-field">
                                    <span class="info-label">Username</span>
                                    <span id="info-username" class="info-value">—</span>
                                </div>
                                <div class="info-field">
                                    <span class="info-label">Email Address</span>
                                    <span id="info-email" class="info-value">—</span>
                                </div>
                                <div class="info-field">
                                    <span class="info-label">Phone Number</span>
                                    <span id="info-phone" class="info-value">—</span>
                                </div>
                            </div>
                            
                            <!-- SaaS Admin Button -->
                            <div id="admin-panel-link-wrapper" style="display: none; margin-top: 1.25rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                <a href="/admin" class="btn btn-secondary w-100" style="border-color: #3b82f6; color: #3b82f6; padding: 0.6rem; font-size: 0.85rem;">
                                    <i class="fa-solid fa-shield-halved"></i> Go to SaaS Admin Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

            </main>
        </div>

        <!-- Bottom Footer Badge Bar -->
        <footer class="footer-badge-bar">
            <div class="footer-badge-item">
                <i class="fa-solid fa-shield-halved footer-badge-icon"></i>
                <div class="footer-badge-text">
                    <span class="footer-badge-title">Secure & Private</span>
                    <span class="footer-badge-desc">Your data is protected</span>
                </div>
            </div>
            <div class="footer-badge-item">
                <i class="fa-solid fa-bolt footer-badge-icon"></i>
                <div class="footer-badge-text">
                    <span class="footer-badge-title">AI Powered</span>
                    <span class="footer-badge-desc">Advanced scanning</span>
                </div>
            </div>
            <div class="footer-badge-item">
                <i class="fa-solid fa-clock-rotate-left footer-badge-icon"></i>
                <div class="footer-badge-text">
                    <span class="footer-badge-title">Real-time Results</span>
                    <span class="footer-badge-desc">Instant data capture</span>
                </div>
            </div>
            <div class="footer-badge-item">
                <i class="fa-solid fa-network-wired footer-badge-icon"></i>
                <div class="footer-badge-text">
                    <span class="footer-badge-title">Multi-Network</span>
                    <span class="footer-badge-desc">All operators supported</span>
                </div>
            </div>
        </footer>

        <!-- Mobile Bottom Nav -->
        <nav class="mobile-footer-nav">
            <div class="mobile-nav-item active" data-tab="dashboard">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </div>
            <div class="mobile-nav-item" data-tab="database">
                <i class="fa-solid fa-database"></i>
                <span>Database</span>
            </div>
            <div class="mobile-nav-item" data-tab="settings">
                <i class="fa-solid fa-gear"></i>
                <span>Settings</span>
            </div>
            <div class="mobile-nav-item" data-tab="profile">
                <i class="fa-solid fa-user"></i>
                <span>Profile</span>
            </div>
        </nav>
    </div>

    <script>
        const socket = io();

        // Server Status Dot Connection Listeners
        socket.on('connect', () => {
            const dot = document.getElementById('server-status-dot');
            if (dot) {
                dot.className = 'server-status-dot online';
                dot.style.background = 'var(--success)';
                dot.style.boxShadow = '0 0 10px var(--success)';
                dot.title = 'Server Connected';
            }
        });
        socket.on('disconnect', () => {
            const dot = document.getElementById('server-status-dot');
            if (dot) {
                dot.className = 'server-status-dot offline';
                dot.style.background = 'var(--danger)';
                dot.style.boxShadow = '0 0 10px var(--danger)';
                dot.title = 'Server Disconnected';
            }
        });

        // ---- TABS LOGIC ----
        function switchTab(target) {
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.querySelectorAll('.mobile-nav-item').forEach(n => n.classList.remove('active'));
            
            // Activate desktop nav
            const dBtn = document.querySelector(`.nav-item[data-tab="${target}"]`);
            if(dBtn) dBtn.classList.add('active');
            
            // Activate mobile nav
            const mBtn = document.querySelector(`.mobile-nav-item[data-tab="${target}"]`);
            if(mBtn) mBtn.classList.add('active');
            
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + target).classList.add('active');

            if (target === 'database') loadDatabase();
            if (target === 'profile') loadUserProfile();
        }

        document.querySelectorAll('.nav-item, .mobile-nav-item').forEach(btn => {
            if(btn.hasAttribute('data-tab')) {
                btn.addEventListener('click', () => {
                    switchTab(btn.getAttribute('data-tab'));
                });
            }
        });

        // ---- DOM ELEMENTS ----
        const fileInput = document.getElementById('file-upload');
        const uploadBtn = document.getElementById('upload-btn');
        const uploadStatus = document.getElementById('upload-status');
        const appStatus = document.getElementById('app-status');
        const progressFill = document.getElementById('waveform-loader-fill');
        const soundwaveScreen = document.getElementById('soundwave-screen');
        const gaugeContainer = document.querySelector('.gauge-container');
        
        const crtStatus = document.getElementById('scanner-crt-status');
        const dataStatus = document.getElementById('scanner-data-status');
        const waStatus = document.getElementById('scanner-wa-status');
        const scannerPhone = document.getElementById('scanner-phone-number');
        const scannerReflection = document.getElementById('scanner-phone-reflection');
        const scannerStatusText = document.getElementById('scanner-status-text');
        const progressPct = document.getElementById('scanner-progress-pct');
        const progressLabel = document.getElementById('scanner-progress-label');
        
        const tbody = document.getElementById('results-table-body');
        const audioAlert = document.getElementById('notification-sound');
        const audioToggle = document.getElementById('audio-toggle');
        
        const waStatusEl = document.getElementById('wa-status');
        const qrCanvas = document.getElementById('qrcode-canvas');
        const disconnectWaBtn = document.getElementById('disconnect-wa-btn');

        // New Controls DOM
        const toggleBtn = document.getElementById('scanner-toggle-btn');
        const toggleIcon = document.getElementById('scanner-toggle-icon');
        const genCountInput = document.getElementById('gen-count-input');
        const loopBtn = document.getElementById('scanner-loop-btn');
        const manualInput = document.getElementById('manual-phone-input');
        const manualBtn = document.getElementById('manual-check-btn');
        const pauseBtn = document.getElementById('scanner-pause-btn');
        const stopBtn = document.getElementById('scanner-stop-btn');
        const prevBtn = document.getElementById('scanner-prev-btn');
        const nextBtn = document.getElementById('scanner-next-btn');
        const playLabel = document.getElementById('scanner-play-label');

        // ---- DASHBOARD LOGIC ----
        let isScanningActive = false;
        let isPaused = false;
        let isLoopActive = false;
        let checkQueue = [];
        let scannedDataCount = 0;
        let whatsappDataCount = 0;

        const soundwaveBars = document.querySelectorAll('.soundwave-bar');

        function pauseSoundwave() {
            soundwaveBars.forEach(bar => {
                bar.style.animationPlayState = 'paused';
            });
        }

        function resumeSoundwave() {
            soundwaveBars.forEach(bar => {
                bar.style.animationPlayState = 'running';
            });
        }

        function stopSoundwave() {
            soundwaveBars.forEach(bar => {
                bar.style.animationPlayState = 'paused';
                bar.style.height = '10px';
            });
        }

        // Initially stop soundwave animation
        stopSoundwave();

        // Loop button toggle
        loopBtn.addEventListener('click', () => {
            isLoopActive = !isLoopActive;
            if (isLoopActive) {
                loopBtn.style.color = '#06b6d4';
                loopBtn.classList.add('active');
            } else {
                loopBtn.style.color = 'var(--text-muted)';
                loopBtn.classList.remove('active');
            }
        });

        // Manual Check trigger
        manualBtn.addEventListener('click', () => {
            const phone = manualInput.value.trim();
            if (!phone) return;
            
            if (isScanningActive) {
                console.log('Error: Engine is running. Stop scan to run manual check.');
                return;
            }
            
            manualInput.value = '';
            
            // Set scanner UI to running state
            isScanningActive = true;
            isPaused = false;
            
            toggleBtn.style = ''; // Clear inline styles
            toggleBtn.classList.add('scanning');
            toggleIcon.className = 'fa-solid fa-pause';
            if (playLabel) playLabel.innerText = 'Running';
            
            if (progressFill) progressFill.style.width = '0%';
            if (soundwaveScreen) soundwaveScreen.classList.add('scanning');
            gaugeContainer.classList.add('scanning');
            resumeSoundwave();
            
            appStatus.className = 'status-badge pulse-active';
            appStatus.innerText = 'Engine Running';
            tbody.innerHTML = '';
            
            // Reset counts
            scannedDataCount = 0;
            whatsappDataCount = 0;
            if (dataStatus) dataStatus.innerText = `Data: 0`;
            if (waStatus) waStatus.innerText = `WA: 0`;
            if (crtStatus) crtStatus.innerText = `CRT: 0/0`;
            if (scannerPhone) scannerPhone.innerText = phone;
            if (scannerReflection) scannerReflection.innerText = phone;
            if (scannerStatusText) scannerStatusText.innerText = 'Checking Fraud History...';
            if (progressPct) progressPct.innerText = '0%';
            if (progressLabel) progressLabel.innerText = 'Starting Manual Check...';

            // Reset gauge and stats cards
            setGaugeValue(0);
            document.getElementById('stat-orders').innerText = '0';
            document.getElementById('stat-delivery').innerText = '0';
            document.getElementById('stat-cancel').innerText = '0';

            socket.emit('start_manual_check', { phone });
        });

        async function startScanning() {
            if (isScanningActive) {
                if (isPaused) {
                    isPaused = false;
                    resumeSoundwave();
                    gaugeContainer.classList.add('scanning');
                    appStatus.className = 'status-badge pulse-active';
                    appStatus.innerText = 'Engine Running';
                    if (playLabel) playLabel.innerText = 'Running';
                    toggleIcon.className = 'fa-solid fa-pause';
                }
                return;
            }
            isScanningActive = true;
            isPaused = false;
            
            toggleBtn.style = ''; // Clear inline styles
            toggleBtn.classList.add('scanning');
            toggleIcon.className = 'fa-solid fa-pause';
            if (playLabel) playLabel.innerText = 'Running';
            
            if (progressFill) progressFill.style.width = '0%';
            if (soundwaveScreen) soundwaveScreen.classList.add('scanning');
            gaugeContainer.classList.add('scanning');
            resumeSoundwave();
            
            appStatus.className = 'status-badge pulse-active';
            appStatus.innerText = 'Engine Running';
            tbody.innerHTML = '';
            
            // Reset counts
            scannedDataCount = 0;
            whatsappDataCount = 0;
            if (dataStatus) dataStatus.innerText = `Data: 0`;
            if (waStatus) waStatus.innerText = `WA: 0`;
            if (crtStatus) crtStatus.innerText = `CRT: 0/0`;
            if (scannerPhone) scannerPhone.innerText = '00000000000';
            if (scannerReflection) scannerReflection.innerText = '00000000000';
            if (scannerStatusText) scannerStatusText.innerText = 'Data Scanning...';
            if (progressPct) progressPct.innerText = '0%';
            if (progressLabel) progressLabel.innerText = 'Loading to Complete...';
            
            // Reset gauge and stats cards
            setGaugeValue(0);
            document.getElementById('stat-orders').innerText = '0';
            document.getElementById('stat-delivery').innerText = '0';
            document.getElementById('stat-cancel').innerText = '0';
            
            if (checkQueue.length > 0) {
                try {
                    await fetch('/api/start', { method: 'POST' });
                } catch (err) {
                    console.error(err);
                }
            } else {
                const count = parseInt(genCountInput.value) || 20;
                socket.emit('start_random_check', { count });
            }
        }
        
        function stopScanning() {
            if (!isScanningActive) return;
            isScanningActive = false;
            isPaused = false;
            
            toggleBtn.style = ''; // Clear inline styles
            toggleBtn.classList.remove('scanning');
            toggleIcon.className = 'fa-solid fa-chevron-right';
            if (playLabel) playLabel.innerText = 'Start';
            
            if (soundwaveScreen) soundwaveScreen.classList.remove('scanning');
            gaugeContainer.classList.remove('scanning');
            stopSoundwave();
            
            appStatus.className = 'status-badge pulse-idle';
            appStatus.innerText = 'Engine Stopped';
            if (progressLabel) progressLabel.innerText = 'Loading to Complete...';
            
            socket.emit('stop_check');
            checkQueue = [];
        }

        toggleBtn.addEventListener('click', () => {
            if (isScanningActive) {
                if (isPaused) {
                    // Resume scanning
                    isPaused = false;
                    resumeSoundwave();
                    gaugeContainer.classList.add('scanning');
                    appStatus.className = 'status-badge pulse-active';
                    appStatus.innerText = 'Engine Running';
                    if (playLabel) playLabel.innerText = 'Running';
                    toggleIcon.className = 'fa-solid fa-pause';
                } else {
                    // Pause scanning
                    isPaused = true;
                    pauseSoundwave();
                    gaugeContainer.classList.remove('scanning');
                    appStatus.className = 'status-badge pulse-idle';
                    appStatus.innerText = 'Engine Paused';
                    if (playLabel) playLabel.innerText = 'Paused';
                    toggleIcon.className = 'fa-solid fa-chevron-right';
                }
            } else {
                startScanning();
            }
        });

        if (pauseBtn) {
            pauseBtn.addEventListener('click', () => {
                if (isScanningActive && !isPaused) {
                    isPaused = true;
                    pauseSoundwave();
                    gaugeContainer.classList.remove('scanning');
                    appStatus.className = 'status-badge pulse-idle';
                    appStatus.innerText = 'Engine Paused';
                    if (playLabel) playLabel.innerText = 'Paused';
                    toggleIcon.className = 'fa-solid fa-chevron-right';
                }
            });
        }

        if (stopBtn) {
            stopBtn.addEventListener('click', () => {
                stopScanning();
            });
        }

        // File upload change binding
        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                uploadBtn.disabled = false;
                fileInput.previousElementSibling.querySelector('span').innerText = fileInput.files[0].name;
            } else {
                uploadBtn.disabled = true;
                fileInput.previousElementSibling.querySelector('span').innerText = 'Select Excel File (.xlsx)';
            }
        });

        document.getElementById('upload-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const file = fileInput.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('excelFile', file);

            uploadBtn.innerHTML = 'Uploading...';
            uploadBtn.disabled = true;

            try {
                const res = await fetch('/api/upload', { method: 'POST', body: formData });
                const data = await res.json();
                
                if (data.success) {
                    uploadStatus.innerHTML = `<i class="fa-solid fa-circle-check"></i> ${data.count} queued.`;
                    uploadStatus.className = "status-text mt-2 text-center text-success";
                    checkQueue = new Array(data.count);
                } else {
                    uploadStatus.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> ${data.error}`;
                    uploadStatus.className = "status-text mt-2 text-center text-danger";
                }
            } catch (err) {
                uploadStatus.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Upload failed.`;
                uploadStatus.className = "status-text mt-2 text-center text-danger";
            }
            uploadBtn.innerHTML = 'Upload';
        });

        function addToFeed(text, isActive = false) {
            console.log(`[FEED] ${text}`);
        }

        // ---- SETTINGS LOGIC ----
        disconnectWaBtn.addEventListener('click', async () => {
            disconnectWaBtn.disabled = true;
            disconnectWaBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Disconnecting...';
            try {
                await fetch('/api/whatsapp/disconnect', { method: 'POST' });
            } catch(e) {
                console.error(e);
            }
            disconnectWaBtn.innerHTML = '<i class="fa-solid fa-plug-circle-xmark"></i> Disconnect WhatsApp Session';
            disconnectWaBtn.disabled = false;
        });

        // ---- GAUGE VISUAL LOGIC ----
        function setGaugeValue(percentage) {
            const progressCircle = document.getElementById('gauge-progress');
            const pctText = document.getElementById('gauge-percentage');
            const badge = document.getElementById('gauge-status-badge');
            const priorityBadge = document.getElementById('gauge-priority-badge');
            const stop1 = document.getElementById('gauge-grad-stop1');
            const stop2 = document.getElementById('gauge-grad-stop2');
            
            const value = parseInt(percentage) || 0;
            
            // Circumference of r=58 circle is ~364
            const offset = 364 - (364 * value) / 100;
            progressCircle.style.strokeDashoffset = offset;
            
            let currentVal = parseInt(pctText.innerText) || 0;
            const duration = 800; // ms
            const startTime = performance.now();
            
            pctText.classList.remove('number-animate');
            void pctText.offsetWidth; // Trigger reflow
            pctText.classList.add('number-animate');
            
            function animate(time) {
                const elapsed = time - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 4); // EaseOutQuart
                const current = Math.round(currentVal + (value - currentVal) * ease);
                pctText.innerText = current + '%';
                
                if (progress < 1) {
                    requestAnimationFrame(animate);
                } else {
                    pctText.innerText = value + '%';
                }
            }
            requestAnimationFrame(animate);
            
            priorityBadge.style.display = 'none';
            
            if (value <= 35) {
                badge.style.display = 'inline-block';
                badge.innerText = 'Risk';
                badge.style.background = '#ef4444';
                stop1.setAttribute('stop-color', '#fb923c'); // orange
                stop2.setAttribute('stop-color', '#ef4444'); // red
            } else if (value <= 55) {
                badge.style.display = 'inline-block';
                badge.innerText = 'Average';
                badge.style.background = '#3b82f6';
                stop1.setAttribute('stop-color', '#3b82f6'); // blue
                stop2.setAttribute('stop-color', '#f97316'); // orange
            } else if (value <= 70) {
                badge.style.display = 'inline-block';
                badge.innerText = 'Inquire';
                badge.style.background = '#f97316';
                stop1.setAttribute('stop-color', '#f97316'); // orange
                stop2.setAttribute('stop-color', '#a3e635'); // green-yellow
            } else if (value <= 89) {
                badge.style.display = 'inline-block';
                badge.innerText = 'Relax';
                badge.style.background = '#a855f7';
                stop1.setAttribute('stop-color', '#a855f7'); // purple
                stop2.setAttribute('stop-color', '#22c55e'); // green
            } else {
                badge.style.display = 'inline-block';
                badge.innerText = 'Legend';
                badge.style.background = '#10b981';
                priorityBadge.style.display = 'inline-block';
                stop1.setAttribute('stop-color', '#10b981'); // green
                stop2.setAttribute('stop-color', '#3b82f6'); // blue
            }
        }

        // ---- SOCKET EVENTS ----
        socket.on('wa_status', (data) => {
            if (data.ready) {
                waStatusEl.innerHTML = '<i class="fa-solid fa-shield-check text-success"></i> Connected';
                qrCanvas.style.display = 'none';
            } else {
                waStatusEl.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${data.message}`;
            }
        });

        socket.on('qr_code', (qrCodeStr) => {
            qrCanvas.style.display = 'block';
            waStatusEl.innerHTML = '<i class="fa-solid fa-qrcode text-primary"></i> Scan this QR';
            QRCode.toCanvas(qrCanvas, qrCodeStr, { width: 200, margin: 1 }, function (error) {
                if (error) console.error(error);
            });
        });

        socket.on('status', (data) => {
            if (data.message.includes('completed')) {
                appStatus.innerText = 'Checking Complete!';
                stopScanning();
                appStatus.className = 'status-badge status-complete';
                addToFeed('Scanning completed');
                
                if (audioToggle.checked) audioAlert.play().catch(e => console.log('Audio error', e));

                // If loop mode is active, restart scanning
                if (isLoopActive) {
                    addToFeed('Loop Mode Active. Starting next scan in 2 seconds...', true);
                    setTimeout(() => {
                        if (isLoopActive) startScanning();
                    }, 2000);
                }
            } else if (data.message.includes('stopped')) {
                appStatus.innerText = 'Engine Stopped';
                stopScanning();
                addToFeed('Scanning stopped');
            } else {
                appStatus.innerText = data.message;
            }
        });

        socket.on('progress', (data) => {
            if (isPaused) return; // Keep visualization paused if user paused it
            
            // Update CRT status pill:
            if (crtStatus) crtStatus.innerText = `CRT: ${data.current}/${data.total}`;
            
            // Update phone numbers inside scanner overlay:
            if (scannerPhone) scannerPhone.innerText = data.phone || '00000000000';
            if (scannerReflection) scannerReflection.innerText = data.phone || '00000000000';
            
            // Update status text:
            if (scannerStatusText) scannerStatusText.innerText = data.status || 'Data Scanning...';
            
            // Calculate percentage and update bar + percentage text:
            const percent = Math.round((data.current / data.total) * 100) || 0;
            if (progressPct) progressPct.innerText = `${percent}%`;
            if (progressFill) progressFill.style.width = `${percent}%`;
            
            addToFeed(`Scanning > ${data.phone}`, true);
        });

        socket.on('result', (data) => {
            if (tbody.querySelector('.empty-state')) tbody.innerHTML = '';
            
            const isSuccess = parseInt(data.successRate) >= 70;
            
            // Dynamic circular gauge & stats cards updates
            if (data.successRate) {
                setGaugeValue(data.successRate);
            }
            document.getElementById('stat-orders').innerText = data.totalOrders || 0;
            document.getElementById('stat-delivery').innerText = data.totalDelivery || 0;
            document.getElementById('stat-cancel').innerText = data.totalCancel || 0;

            const tr = document.createElement('tr');
            tr.className = 'row-enter';
            
            // Format Courier Column
            let courierHtml = '';
            if (data.courier && data.courier !== '-') {
                courierHtml = `
                    <div class="courier-badge-container">
                        <img src="/assets/courier-logo/${data.courier}.svg" class="courier-logo-img" alt="${data.courier}" onerror="this.style.display='none'; this.nextElementSibling.style.fontSize='0.85rem';">
                        <div class="courier-badge-count">${data.totalOrders || 0}</div>
                    </div>
                `;
            }
            
            tr.innerHTML = `
                <td class="font-bold">${data.phone}</td>
                <td>${courierHtml}</td>
                <td>${data.totalOrders || 0}</td>
                <td>${data.totalDelivery || 0}</td>
                <td>${data.totalCancel || 0}</td>
                <td><span class="pill ${isSuccess ? 'pill-success' : 'pill-danger'}">${data.successRate}</span></td>
                <td>${data.hasWhatsApp ? '<i class="fa-brands fa-whatsapp text-success" style="font-size:1.2rem;"></i>' : '<span class="text-muted">—</span>'}</td>
            `;
            tbody.insertBefore(tr, tbody.firstChild);
            
            addToFeed(`Matched > ${data.phone} added to DB`, false);
            setTimeout(() => tr.classList.remove('row-enter'), 500);
        });

        // ---- DATABASE LOGIC ----
        let dbCache = {};
        let selectedStartDate = null;
        let selectedEndDate = null;
        let currentDatePickerDate = new Date();

        // Helper to parse "M/D/YYYY" string to a Date object
        function parseDateKey(dateStr) {
            const parts = dateStr.split('/');
            if (parts.length === 3) {
                return new Date(parseInt(parts[2]), parseInt(parts[0]) - 1, parseInt(parts[1]));
            }
            return new Date(dateStr);
        }

        function formatDateForDisplay(dateObj) {
            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            return `${monthNames[dateObj.getMonth()]} ${dateObj.getDate()}, ${dateObj.getFullYear()}`;
        }

        async function loadDatabase() {
            const tbody = document.getElementById('db-details-tbody');
            tbody.innerHTML = '<tr class="empty-state"><td colspan="7"><i class="fa-solid fa-spinner fa-spin empty-icon"></i><p>Loading database...</p></td></tr>';
            
            try {
                const res = await fetch('/api/database');
                const json = await res.json();
                
                if (json.success) {
                    dbCache = json.data;
                    
                    // Default selection: find the most recent date in dbCache
                    const dates = Object.keys(dbCache).sort((a, b) => parseDateKey(b) - parseDateKey(a));
                    if (dates.length > 0) {
                        const latestDate = parseDateKey(dates[0]);
                        selectedStartDate = latestDate;
                        selectedEndDate = latestDate;
                        currentDatePickerDate = new Date(latestDate);
                        
                        applyDateRangeFilter();
                    } else {
                        tbody.innerHTML = '<tr class="empty-state"><td colspan="7"><i class="fa-solid fa-box-open empty-icon"></i><p>No records found in database.</p></td></tr>';
                        document.getElementById('db-selected-date').innerText = 'Select Date';
                        document.getElementById('db-record-count').innerText = '0 records';
                    }
                } else {
                    tbody.innerHTML = '<tr class="empty-state"><td colspan="7"><i class="fa-solid fa-circle-xmark empty-icon"></i><p>Failed to load data.</p></td></tr>';
                }
            } catch(e) {
                console.error(e);
                tbody.innerHTML = '<tr class="empty-state"><td colspan="7"><i class="fa-solid fa-circle-xmark empty-icon"></i><p>Network error.</p></td></tr>';
            }
            
            initDatePickerEvents();
        }

        function applyDateRangeFilter() {
            if (!selectedStartDate) return;
            
            const start = new Date(selectedStartDate.getFullYear(), selectedStartDate.getMonth(), selectedStartDate.getDate());
            const end = selectedEndDate 
                ? new Date(selectedEndDate.getFullYear(), selectedEndDate.getMonth(), selectedEndDate.getDate())
                : new Date(selectedStartDate.getFullYear(), selectedStartDate.getMonth(), selectedStartDate.getDate());
            
            // Format title
            let titleText = formatDateForDisplay(start);
            if (selectedEndDate && start.toDateString() !== end.toDateString()) {
                titleText = `${formatDateForDisplay(start)} - ${formatDateForDisplay(end)}`;
            }
            document.getElementById('db-selected-date').innerText = titleText;
            
            // Filter records
            const filteredRecords = [];
            Object.keys(dbCache).forEach(dateKey => {
                const dateObj = parseDateKey(dateKey);
                const compareDate = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate());
                
                if (compareDate >= start && compareDate <= end) {
                    filteredRecords.push(...dbCache[dateKey]);
                }
            });
            
            // Sort by checkTime descending
            filteredRecords.sort((a, b) => new Date(b.checkTime) - new Date(a.checkTime));
            
            document.getElementById('db-record-count').innerText = `${filteredRecords.length} records`;
            
            const tbody = document.getElementById('db-details-tbody');
            if (filteredRecords.length === 0) {
                tbody.innerHTML = '<tr class="empty-state"><td colspan="7"><i class="fa-solid fa-box-open empty-icon"></i><p>No records found for selected range.</p></td></tr>';
                return;
            }
            
            tbody.innerHTML = '';
            filteredRecords.forEach(data => {
                const isSuccess = parseInt(data.successRate) >= 70;
                let courierHtml = '';
                if (data.courier && data.courier !== '-') {
                    courierHtml = `
                        <div class="courier-badge-container">
                            <img src="/assets/courier-logo/${data.courier}.svg" class="courier-logo-img" alt="${data.courier}">
                            <div class="courier-badge-count">${data.totalOrders || 0}</div>
                        </div>
                    `;
                }
                
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="font-bold">${data.phone}</td>
                    <td>${courierHtml}</td>
                    <td>${data.totalOrders || 0}</td>
                    <td>${data.totalDelivery || 0}</td>
                    <td>${data.totalCancel || 0}</td>
                    <td><span class="pill ${isSuccess ? 'pill-success' : 'pill-danger'}">${data.successRate}</span></td>
                    <td>${data.hasWhatsApp ? '<i class="fa-brands fa-whatsapp text-success" style="font-size:1.1rem;"></i>' : '<span class="text-muted">—</span>'}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- Date Picker Logic ---
        let datePickerInitialized = false;

        function initDatePickerEvents() {
            if (datePickerInitialized) return;
            datePickerInitialized = true;
            
            const trigger = document.getElementById('db-date-trigger');
            const popup = document.getElementById('db-datepicker-popup');
            const prevBtn = document.getElementById('prev-month-btn');
            const nextBtn = document.getElementById('next-month-btn');
            const updateBtn = document.getElementById('datepicker-update-btn');
            
            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                const isDisplayed = popup.style.display === 'block';
                popup.style.display = isDisplayed ? 'none' : 'block';
                if (!isDisplayed) {
                    renderCalendar();
                }
            });
            
            popup.addEventListener('click', (e) => {
                e.stopPropagation(); // Prevent closing when clicking inside popup
            });
            
            document.addEventListener('click', () => {
                popup.style.display = 'none';
            });
            
            prevBtn.addEventListener('click', () => {
                currentDatePickerDate.setMonth(currentDatePickerDate.getMonth() - 1);
                renderCalendar();
            });
            
            nextBtn.addEventListener('click', () => {
                currentDatePickerDate.setMonth(currentDatePickerDate.getMonth() + 1);
                renderCalendar();
            });
            
            updateBtn.addEventListener('click', () => {
                popup.style.display = 'none';
                applyDateRangeFilter();
            });
        }

        function renderCalendar() {
            const grid = document.getElementById('datepicker-days-grid');
            const title = document.getElementById('datepicker-month-year');
            grid.innerHTML = '';
            
            const year = currentDatePickerDate.getFullYear();
            const month = currentDatePickerDate.getMonth();
            
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            title.innerText = `${monthNames[month]} ${year}`;
            
            const firstDay = new Date(year, month, 1);
            const startDayIndex = (firstDay.getDay() + 6) % 7;
            const totalDays = new Date(year, month + 1, 0).getDate();
            
            // Empty grid slots before start day
            for (let i = 0; i < startDayIndex; i++) {
                const span = document.createElement('span');
                span.className = 'empty';
                grid.appendChild(span);
            }
            
            const today = new Date();
            
            for (let day = 1; day <= totalDays; day++) {
                const span = document.createElement('span');
                span.innerText = day;
                const dateObj = new Date(year, month, day);
                
                if (dateObj.toDateString() === today.toDateString()) {
                    span.classList.add('today');
                }
                
                // Style selection
                if (selectedStartDate && dateObj.toDateString() === selectedStartDate.toDateString()) {
                    if (selectedEndDate && selectedStartDate.toDateString() !== selectedEndDate.toDateString()) {
                        span.classList.add('selected-start');
                    } else {
                        span.classList.add('selected-single');
                    }
                } else if (selectedEndDate && dateObj.toDateString() === selectedEndDate.toDateString()) {
                    span.classList.add('selected-end');
                } else if (selectedStartDate && selectedEndDate && dateObj > selectedStartDate && dateObj < selectedEndDate) {
                    span.classList.add('selected-range');
                }
                
                span.addEventListener('click', () => {
                    handleDayClick(dateObj);
                });
                
                grid.appendChild(span);
            }
        }

        function handleDayClick(dateObj) {
            if (!selectedStartDate || (selectedStartDate && selectedEndDate)) {
                selectedStartDate = dateObj;
                selectedEndDate = null;
            } else if (selectedStartDate && !selectedEndDate) {
                if (dateObj < selectedStartDate) {
                    selectedStartDate = dateObj;
                } else {
                    selectedEndDate = dateObj;
                }
            }
            renderCalendar();
        }

        // ---- USER PROFILE SPA LOGIC ----
        async function loadUserProfile() {
            try {
                const res = await fetch('/api/profile');
                const data = await res.json();
                if (data.success) {
                    const user = data.user;
                    
                    // Update user card details
                    document.getElementById('profile-card-name').innerText = user.username;
                    document.getElementById('profile-card-role').innerText = user.role;
                    document.getElementById('info-username').innerText = user.username;
                    document.getElementById('info-email').innerText = user.email || 'Not specified';
                    document.getElementById('info-phone').innerText = user.phone || 'Not specified';
                    
                    // Subscription Plan Details
                    document.getElementById('plan-name').innerText = user.plan_name || 'Free Trial';
                    document.getElementById('plan-status').innerText = user.plan_status || 'Active';
                    document.getElementById('plan-expires').innerText = user.plan_expires || 'Never';
                    
                    const statusEl = document.getElementById('plan-status');
                    if (user.plan_status === 'Active') {
                        statusEl.className = 'pill pill-success';
                    } else {
                        statusEl.className = 'pill pill-danger';
                    }
                    
                    // Sync Topbar User Avatar representation
                    const headerAvatar = document.querySelector('.user-avatar');
                    const avatarImg = document.getElementById('profile-avatar-img');
                    const avatarPlaceholder = document.getElementById('profile-avatar-placeholder');
                    
                    if (user.profile_pic) {
                        avatarImg.src = user.profile_pic;
                        avatarImg.style.display = 'block';
                        avatarPlaceholder.style.display = 'none';
                        if (headerAvatar) {
                            headerAvatar.innerHTML = `<img src="${user.profile_pic}" style="width:100%; height:100%; border-radius:50%; object-fit:cover;" />`;
                        }
                    } else {
                        avatarImg.src = '/assets/ai-avatar.png';
                        avatarImg.style.display = 'block';
                        avatarPlaceholder.style.display = 'none';
                        if (headerAvatar) {
                            headerAvatar.innerHTML = `<img src="/assets/ai-avatar.png" style="width:100%; height:100%; border-radius:50%; object-fit:cover;" />`;
                        }
                    }
                    
                    // Toggle SaaS Admin Dashboard visibility
                    const adminLink = document.getElementById('admin-panel-link-wrapper');
                    if (user.role === 'admin') {
                        adminLink.style.display = 'block';
                    } else {
                        adminLink.style.display = 'none';
                    }
                }
            } catch(e) {
                console.error("Error loading user profile information:", e);
            }
        }

        // Avatar change handler
        const avatarInput = document.getElementById('avatar-input');
        if (avatarInput) {
            avatarInput.addEventListener('change', async () => {
                if (avatarInput.files.length === 0) return;
                const file = avatarInput.files[0];
                const formData = new FormData();
                formData.append('profilePic', file);
                
                try {
                    const res = await fetch('/api/profile/upload-pic', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    if (data.success) {
                        loadUserProfile(); // Re-fetch to sync views
                    }
                } catch(e) {
                    console.error("Error uploading profile image:", e);
                }
            });
        }
        
        // Avatar remove handler
        const removeAvatarBtn = document.getElementById('remove-avatar-btn');
        if (removeAvatarBtn) {
            removeAvatarBtn.addEventListener('click', async () => {
                if (confirm('Are you sure you want to remove your profile picture?')) {
                    try {
                        const res = await fetch('/api/profile/remove-pic', {
                            method: 'POST'
                        });
                        const data = await res.json();
                        if (data.success) {
                            loadUserProfile(); // Re-fetch
                        }
                    } catch(e) {
                        console.error("Error removing profile image:", e);
                    }
                }
            });
        }
        
        // Subscription renew handler
        const renewPlanBtn = document.getElementById('renew-plan-btn');
        if (renewPlanBtn) {
            renewPlanBtn.addEventListener('click', () => {
                alert('Plan renewal simulated: Gateway connection established successfully!');
            });
        }

        // Automatically fetch initial avatar on page load to sync top header representation
        loadUserProfile();

        // ---- LANGUAGE SWITCHER LOGIC ----
        let currentLang = 'EN';
        function toggleLanguage() {
            const langFlag = document.getElementById('lang-flag');
            const langText = document.getElementById('lang-text');
            
            if (currentLang === 'EN') {
                currentLang = 'BN';
                langFlag.src = 'https://flagcdn.com/w20/gb.png';
                langText.innerText = 'EN';
                alert('Language switched to Bengali (BN) - UI translation hooks have been initialized.');
            } else {
                currentLang = 'EN';
                langFlag.src = 'https://flagcdn.com/w20/bd.png';
                langText.innerText = 'BN';
                alert('Language switched to English (EN).');
            }
        }
    </script>
</body>
</html>
