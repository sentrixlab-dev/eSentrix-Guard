<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ai Courier Data Checker Pro</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
</head>
<body>
    <audio id="notification-sound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

    <div class="app-container">
        
        <!-- Global Top Header -->
        <header class="main-header">
            <div class="header-logo-group" style="display: flex; align-items: center;">
                <div class="header-logo-icon-wrap" style="width: 76px; display: flex; justify-content: center; align-items: center; margin-left: -2rem;">
                    <img src="/assets/5start-logo.png" class="logo-image" style="width: 42px; height: auto;" alt="Logo">
                </div>
                <h2 style="font-size: 1.2rem; font-weight: 600; margin: 0; margin-left: 0.25rem; letter-spacing: -0.01em; display: flex; align-items: center; gap: 6px;">
                    5 Star AI EC Data Gen
                    <span class="pro-badge">Pro</span>
                </h2>
            </div>
            <div class="header-actions" style="display: flex; align-items: center; gap: 1.25rem;">
                <i class="fa-regular fa-sun header-icon" style="font-size: 1.1rem;"></i>
                <i class="fa-regular fa-bell header-icon" style="font-size: 1.1rem;"></i>
                
                <!-- Language Switcher Pill -->
                <div class="lang-switcher" id="lang-switcher" style="display: flex; align-items: center; gap: 6px; padding: 0.35rem 0.6rem; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); border-radius: 2rem; cursor: pointer; transition: var(--transition);" onclick="toggleLanguage()">
                    <img id="lang-flag" src="https://flagcdn.com/w20/bd.png" width="16" height="12" style="border-radius: 2px; object-fit: cover;" alt="BN">
                    <span id="lang-text" style="font-size: 0.75rem; font-weight: 600; color: var(--text-main);">BN</span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem; color: var(--text-muted);"></i>
                </div>

                <div class="user-profile" onclick="switchTab('profile')" style="padding: 2px; border-radius: 50%; border: 1.5px solid #0ea5e9; box-shadow: 0 0 8px rgba(14, 165, 233, 0.4); background: #09090b; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: var(--transition);">
                    <div class="user-avatar" style="width: 100%; height: 100%; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        <img src="/assets/ai-avatar.png" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" alt="AI Avatar">
                    </div>
                </div>
            </div>
        </header>

        <!-- Header Ticker Marquee -->
        <div class="header-ticker">
            <div class="ticker-content">
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #f97316;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #22c55e;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #06b6d4;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #ef4444;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
                <!-- Duplicate for infinite seamless scroll loop -->
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #f97316;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #22c55e;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #06b6d4;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
                <div class="ticker-item"><i class="fa-solid fa-truck" style="color: #ef4444;"></i> Check Bangladeshi Largest Courier Customer Fraud Status</div>
            </div>
        </div>

        <!-- Body Area -->
        <div class="app-body">
            
            <!-- Sidebar Navigation (Desktop) -->
            <aside class="sidebar">
                <nav class="nav-menu" style="display: flex; flex-direction: column; align-items: center; gap: 1.25rem; padding: 1rem 0;">
                    <button class="nav-item active" data-tab="dashboard" title="Dashboard" style="display: flex; justify-content: center; align-items: center; width: 42px; height: 42px; padding: 0; border-radius: 0.75rem;">
                        <i class="fa-solid fa-house" style="font-size: 1.15rem;"></i>
                    </button>
                    <button class="nav-item" data-tab="database" title="Database" style="display: flex; justify-content: center; align-items: center; width: 42px; height: 42px; padding: 0; border-radius: 0.75rem;">
                        <i class="fa-solid fa-database" style="font-size: 1.15rem;"></i>
                    </button>
                    <button class="nav-item" data-tab="analytics" title="Analytics" style="display: flex; justify-content: center; align-items: center; width: 42px; height: 42px; padding: 0; border-radius: 0.75rem;">
                        <i class="fa-solid fa-chart-line" style="font-size: 1.15rem;"></i>
                    </button>
                    <button class="nav-item" data-tab="profile" title="User Profile" style="display: flex; justify-content: center; align-items: center; width: 42px; height: 42px; padding: 0; border-radius: 0.75rem;">
                        <i class="fa-solid fa-user" style="font-size: 1.15rem;"></i>
                    </button>
                </nav>
                <div class="sidebar-footer" style="display: flex; flex-direction: column; align-items: center; padding: 1rem 0; width: 100%;">
                    <button class="nav-item" data-tab="settings" title="Settings" style="display: flex; justify-content: center; align-items: center; width: 42px; height: 42px; padding: 0; border-radius: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">
                        <i class="fa-solid fa-gear" style="font-size: 1.15rem;"></i>
                    </button>
                    <div style="width: 100%; border-top: 1px solid var(--border-color); padding-top: 1rem; display: flex; flex-direction: column; align-items: center; gap: 6px;">
                        <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Server</span>
                        <div class="server-status-dot online" id="server-status-dot" title="Server Connected" style="width: 10px; height: 10px; border-radius: 50%; background: var(--success); box-shadow: 0 0 10px var(--success); transition: var(--transition);"></div>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="content-area">
                
                <!-- TAB: DASHBOARD -->
                <section id="tab-dashboard" class="tab-content active">
                    
                    <div class="dashboard-grid">
                        <!-- Left Column: Controls -->
                        <div class="controls-col">
                            
                            <!-- Scan Overview Card -->
                            <div class="card gauge-card">
                                <div class="card-header" style="margin-bottom: 0.5rem; padding-bottom: 0.4rem; justify-content: flex-start; gap: 8px;">
                                    <i class="fa-solid fa-compass text-primary"></i>
                                    <h3>Scan Overview</h3>
                                </div>
                                <div class="scan-overview-grid">
                                    <!-- Left side: Circular Gauge -->
                                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                        <div class="gauge-container" style="margin: 0;">
                                            <div class="gauge-bg-circle"></div>
                                            <svg width="140" height="140" viewBox="0 0 140 140" style="transform: rotate(-90deg);">
                                                <circle cx="70" cy="70" r="58" stroke="rgba(255,255,255,0.03)" stroke-width="10" fill="transparent" />
                                                <circle id="gauge-progress" cx="70" cy="70" r="58" stroke="url(#gauge-gradient)" stroke-width="10" fill="transparent"
                                                    stroke-dasharray="364.4" stroke-dashoffset="364.4" stroke-linecap="round" style="transition: stroke-dashoffset 0.8s cubic-bezier(0.4, 0, 0.2, 1);" />
                                                <defs>
                                                    <linearGradient id="gauge-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                                        <stop id="gauge-grad-stop1" offset="0%" stop-color="#ef4444" />
                                                        <stop id="gauge-grad-stop2" offset="100%" stop-color="#fb7185" />
                                                    </linearGradient>
                                                </defs>
                                            </svg>
                                            <div class="gauge-overlay">
                                                <span id="gauge-status-badge" style="font-size: 0.72rem; font-weight: 700; padding: 3px 9px; border-radius: 12px; margin-bottom: 6px; text-transform: uppercase; background: #ef4444; color: #fff;">Risk</span>
                                                <span id="gauge-percentage" style="font-size: 2.25rem; font-weight: 700; color: #fff; line-height: 1;">0%</span>
                                                <span id="gauge-priority-badge" style="display: none; font-size: 0.65rem; color: var(--text-muted); background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); padding: 2px 8px; border-radius: 8px; margin-top: 6px; font-weight: 500;">Priority Customer</span>
                                            </div>
                                        </div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.35rem;" id="gauge-threat-level">Low Risk</div>
                                    </div>

                                    <!-- Right side: Stack of stats -->
                                    <div class="stats-vertical-stack">
                                        <div class="stat-widget-premium" style="border-left: 3px solid #3b82f6;">
                                            <div class="stat-widget-icon" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                                                <i class="fa-solid fa-cart-shopping"></i>
                                            </div>
                                            <div class="stat-widget-info">
                                                <span class="stat-widget-label">Total Order</span>
                                                <span id="stat-orders" class="stat-widget-value">0</span>
                                            </div>
                                        </div>
                                        <div class="stat-widget-premium" style="border-left: 3px solid #10b981;">
                                            <div class="stat-widget-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                                                <i class="fa-solid fa-circle-check"></i>
                                            </div>
                                            <div class="stat-widget-info">
                                                <span class="stat-widget-label">Total Delivery</span>
                                                <span id="stat-delivery" class="stat-widget-value">0</span>
                                            </div>
                                        </div>
                                        <div class="stat-widget-premium" style="border-left: 3px solid #ef4444;">
                                            <div class="stat-widget-icon" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
                                                <i class="fa-solid fa-circle-xmark"></i>
                                            </div>
                                            <div class="stat-widget-info">
                                                <span class="stat-widget-label">Total Cancel</span>
                                                <span id="stat-cancel" class="stat-widget-value">0</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- AI Scanner Engine Card (Merged) -->
                            <div class="card action-card">
                                <div class="card-header" style="margin-bottom: 0.5rem; padding-bottom: 0.4rem; justify-content: flex-start; gap: 8px;">
                                    <i class="fa-solid fa-microchip text-primary"></i>
                                    <h3>AI Scanner Engine</h3>
                                </div>
                                
                                <div style="display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                                    <!-- Status Badge Pill row -->
                                    <div style="display: flex; gap: 8px; justify-content: center; width: 100%; margin-bottom: 0.15rem;">
                                        <span class="pill" style="background: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.25); font-weight: 600; font-size: 0.68rem;" id="scanner-crt-status">CRT: 0/0</span>
                                        <span class="pill" style="background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.25); font-weight: 600; font-size: 0.68rem;" id="scanner-data-status">Data: 0</span>
                                        <span class="pill" style="background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.25); font-weight: 600; font-size: 0.68rem;" id="scanner-wa-status">WA: 0</span>
                                    </div>

                                    <!-- Soundwave Visual Screen -->
                                    <div class="soundwave-screen" id="soundwave-screen" style="height: 120px;">
                                        <!-- Animated Waveform Bars -->
                                        <div class="soundwave-grid" id="soundwave-grid" style="height: 40px;">
                                            <div class="soundwave-bar" style="height: 10px;"></div>
                                            <div class="soundwave-bar" style="height: 18px;"></div>
                                            <div class="soundwave-bar" style="height: 28px;"></div>
                                            <div class="soundwave-bar" style="height: 14px;"></div>
                                            <div class="soundwave-bar" style="height: 22px;"></div>
                                            <div class="soundwave-bar" style="height: 30px;"></div>
                                            <div class="soundwave-bar" style="height: 16px;"></div>
                                            <div class="soundwave-bar" style="height: 12px;"></div>
                                            <div class="soundwave-bar" style="height: 20px;"></div>
                                            <div class="soundwave-bar" style="height: 26px;"></div>
                                            <div class="soundwave-bar" style="height: 18px;"></div>
                                            <div class="soundwave-bar" style="height: 10px;"></div>
                                            <div class="soundwave-bar" style="height: 15px;"></div>
                                            <div class="soundwave-bar" style="height: 22px;"></div>
                                            <div class="soundwave-bar" style="height: 8px;"></div>
                                            <div class="soundwave-bar" style="height: 18px;"></div>
                                            <div class="soundwave-bar" style="height: 25px;"></div>
                                            <div class="soundwave-bar" style="height: 12px;"></div>
                                        </div>
                                        
                                        <!-- Text/Number overlay -->
                                        <div class="scanning-phone-overlay">
                                            <span class="scanning-status-text" id="scanner-status-text">Data Scanning...</span>
                                            <span class="scanning-phone-number" id="scanner-phone-number" style="font-size: 1.6rem; text-shadow: 0 0 10px rgba(6, 182, 212, 0.8);">00000000000</span>
                                            <span class="scanning-phone-reflection" id="scanner-phone-reflection" style="font-size: 0.8rem; margin-top: 2px;">00000000000</span>
                                        </div>

                                        <!-- Progress loader -->
                                        <div class="scanning-progress-bar-wrap">
                                            <div class="scanning-progress-info" style="font-size: 0.6rem;">
                                                <span id="scanner-progress-label">Loading to Complete...</span>
                                                <span id="scanner-progress-pct">0%</span>
                                            </div>
                                            <div class="waveform-loader-bar" style="height: 4px;">
                                                <div class="waveform-loader-fill" id="waveform-loader-fill" style="width: 0%;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Manual Number Check section inside card -->
                                    <div style="border-top: 1px solid var(--border-color); padding-top: 0.5rem; margin-top: 0.25rem;">
                                        <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 6px;">
                                            <i class="fa-solid fa-phone-volume text-primary" style="font-size: 0.8rem;"></i>
                                            Manual Number Check
                                        </div>
                                        <div class="manual-check-container" style="display: flex; gap: 8px; margin-bottom: 0.5rem;">
                                            <input type="text" id="manual-phone-input" placeholder="Enter mobile number (e.g. 01XXXXXXXXX)" style="flex: 1; padding: 0.4rem 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid var(--border-color); border-radius: 0.5rem; color: #fff; font-size: 0.8rem; height: 32px; box-sizing: border-box;" />
                                            <button type="button" id="manual-check-btn" class="btn btn-secondary" style="padding: 0 0.75rem; font-size: 0.8rem; border: 1px solid #10b981; color: #10b981; background: transparent; height: 32px; box-sizing: border-box;">Check</button>
                                        </div>
                                        
                                        <div class="scanner-controls-row" style="display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 0 0.25rem;">
                                            <div class="console-control-wrapper">
                                                <button class="console-control-btn" id="scanner-pause-btn" title="Pause Scanner" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    <i class="fa-solid fa-pause"></i>
                                                </button>
                                                <span class="console-control-label" style="font-size: 0.55rem;">Pause</span>
                                            </div>
                                            <div class="console-control-wrapper">
                                                <button class="console-control-btn" id="scanner-prev-btn" title="Previous Item" disabled style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    <i class="fa-solid fa-backward-step"></i>
                                                </button>
                                                <span class="console-control-label" style="font-size: 0.55rem;">Prev</span>
                                            </div>
                                            <div class="console-control-wrapper">
                                                <button class="console-control-btn console-circle-play" id="scanner-toggle-btn" title="Start/Resume Scanner" style="width: 46px; height: 46px; font-size: 1.1rem;">
                                                    <i class="fa-solid fa-chevron-right" id="scanner-toggle-icon"></i>
                                                </button>
                                                <span class="console-control-label" style="font-weight: 700; color: #06b6d4; margin-top: 4px; font-size: 0.55rem;" id="scanner-play-label">Start</span>
                                            </div>
                                            <div class="console-control-wrapper">
                                                <button class="console-control-btn" id="scanner-next-btn" title="Next Item" disabled style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    <i class="fa-solid fa-forward-step"></i>
                                                </button>
                                                <span class="console-control-label" style="font-size: 0.55rem;">Next</span>
                                            </div>
                                            <div class="console-control-wrapper">
                                                <button class="console-control-btn" id="scanner-stop-btn" title="Stop Scanner" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    <i class="fa-solid fa-square"></i>
                                                </button>
                                                <span class="console-control-label" style="font-size: 0.55rem;">Stop</span>
                                            </div>
                                        </div>
                                        
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; padding: 0 0.25rem;">
                                            <div style="display: flex; align-items: center; gap: 6px; background: rgba(0,0,0,0.35); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 0.25rem 0.5rem; height: 28px; box-sizing: border-box;">
                                                <span style="font-size: 0.7rem; color: var(--text-muted); font-weight: 500;">QTY:</span>
                                                <input type="number" id="gen-count-input" value="20" min="1" max="500" style="width: 30px; background: transparent; border: none; color: #fff; text-align: center; font-size: 0.8rem; font-weight: 600; outline: none;" />
                                            </div>
                                            <button id="scanner-loop-btn" class="btn-loop-toggle" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 50%; color: var(--text-muted); cursor: pointer; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; transition: var(--transition);" title="Toggle Loop Mode">
                                                <i class="fa-solid fa-rotate"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Upload Card -->
                            <div class="card upload-card" style="display: flex; flex-direction: column; min-height: 80px;">
                                <div class="card-header" style="margin-bottom: 0.35rem; padding-bottom: 0.3rem; width: 100%; justify-content: flex-start; gap: 8px;">
                                    <i class="fa-solid fa-file-excel text-primary"></i>
                                    <h3>Data Source</h3>
                                </div>
                                <div style="display: flex; flex: 1; align-items: center; justify-content: center; width: 100%; margin-top: auto; margin-bottom: auto;">
                                    <form id="upload-form" style="display: flex; align-items: center; gap: 12px; width: 100%;">
                                        <label for="file-upload" class="file-drop-zone" style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 4px 0.5rem; border: 1.5px dashed rgba(255,255,255,0.25); border-radius: 0.5rem; cursor: pointer; background: rgba(255,255,255,0.02); margin-bottom: 0; height: 38px; box-sizing: border-box; transition: var(--transition);">
                                            <i class="fa-solid fa-cloud-arrow-up" style="font-size: 0.9rem; color: var(--text-muted);"></i>
                                            <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; font-size: 0.6rem; font-weight: 500; color: var(--text-muted);">Select Excel File (.xlsx)</span>
                                        </label>
                                        <input id="file-upload" type="file" accept=".xlsx, .xls" />
                                        <button type="submit" class="btn btn-primary-gradient" id="upload-btn" disabled style="padding: 0 1.25rem; font-size: 0.8rem; height: 38px; border-radius: 0.5rem; box-sizing: border-box;">
                                            Upload
                                        </button>
                                    </form>
                                </div>
                                <div id="upload-status" class="status-text mt-1 text-center" style="font-size: 0.7rem;"></div>
                            </div>
                        </div>

                        <!-- Right Column: Results -->
                        <div class="results-col">
                            <div class="card h-100 table-card">
                                <div class="card-header justify-between">
                                    <div class="flex-center gap-2">
                                        <i class="fa-solid fa-list-check text-primary"></i>
                                        <h3>Live Results</h3>
                                    </div>
                                    <div class="flex-center gap-2 text-muted" style="font-size: 0.8rem;">
                                        <div id="app-status" class="status-badge pulse-idle">Ready</div>
                                    </div>
                                </div>
                                <div class="table-container custom-scrollbar">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th><i class="fa-solid fa-phone" style="color: #3b82f6;"></i> Phone</th>
                                                <th><i class="fa-solid fa-truck" style="color: #f97316;"></i> Courier</th>
                                                <th><i class="fa-solid fa-clipboard-list" style="color: #0ea5e9;"></i> Order</th>
                                                <th><i class="fa-solid fa-circle-check" style="color: #10b981;"></i> Delivery</th>
                                                <th><i class="fa-solid fa-circle-xmark" style="color: #ef4444;"></i> Cancel</th>
                                                <th>% Rate</th>
                                                <th><i class="fa-brands fa-whatsapp" style="color: #22c55e;"></i> WhatsApp</th>
                                            </tr>
                                        </thead>
                                        <tbody id="results-table-body">
                                            <tr class="empty-state">
                                                <td colspan="7">
                                                    <i class="fa-solid fa-box-open empty-icon"></i>
                                                    <p>No data yet. Start the scanner to see live results.</p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB: DATABASE -->
                <section id="tab-database" class="tab-content">
                    <header class="topbar">
                        <div>
                            <h1 class="page-title text-primary">Historical Database</h1>
                            <p class="subtitle">Browse past records grouped by date</p>
                        </div>
                        <button class="btn btn-secondary" onclick="loadDatabase()">
                            <i class="fa-solid fa-rotate-right"></i> Refresh
                        </button>
                    </header>

                    <div class="database-layout">
                        <!-- Date Details -->
                        <div class="card date-details-card" style="position: relative;">
                            <div class="card-header justify-between" style="position: relative;">
                                <div class="date-picker-trigger" id="db-date-trigger" style="cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-weight: 500; padding: 0.5rem 1rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem; transition: var(--transition);">
                                    <span id="db-selected-date">Select Date</span>
                                    <i class="fa-regular fa-calendar-days text-primary"></i>
                                </div>
                                <span class="pill pill-success" id="db-record-count">0 records</span>

                                <!-- Custom Date Picker Popup -->
                                <div class="custom-datepicker" id="db-datepicker-popup" style="display: none; position: absolute; top: calc(100% - 15px); left: 1.5rem; z-index: 100; background: #18181b; border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 1.25rem; width: 320px; box-shadow: 0 15px 35px rgba(0,0,0,0.6); margin-top: 5px;">
                                    <!-- Datepicker Header -->
                                    <div class="datepicker-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                                        <span id="datepicker-month-year" style="font-weight: 600; font-size: 1rem; color: #fff;">June 2026</span>
                                        <div style="display: flex; gap: 15px;">
                                            <button type="button" id="prev-month-btn" style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 1rem;"><i class="fa-solid fa-chevron-left"></i></button>
                                            <button type="button" id="next-month-btn" style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 1rem;"><i class="fa-solid fa-chevron-right"></i></button>
                                        </div>
                                    </div>
                                    <!-- Weekdays -->
                                    <div class="datepicker-weekdays" style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 0.75rem; color: var(--text-muted); font-weight: bold; margin-bottom: 0.5rem; text-transform: uppercase;">
                                        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                                    </div>
                                    <!-- Days Grid -->
                                    <div class="datepicker-days" id="datepicker-days-grid" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center;">
                                        <!-- Dynamically generated days -->
                                    </div>
                                    <!-- Datepicker Footer -->
                                    <div class="datepicker-footer" style="display: flex; justify-content: flex-end; margin-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.75rem;">
                                        <button type="button" id="datepicker-update-btn" class="btn btn-primary" style="padding: 0.4rem 1rem; font-size: 0.8rem; border-radius: 0.5rem;">Update</button>
                                    </div>
                                </div>
                            </div>
                            <div class="table-container custom-scrollbar mt-3">
                                <table>
                                    <thead>
                                        <tr>
                                            <th><i class="fa-solid fa-phone" style="color: #3b82f6;"></i> Phone</th>
                                            <th><i class="fa-solid fa-truck" style="color: #f97316;"></i> Courier</th>
                                            <th><i class="fa-solid fa-clipboard-list" style="color: #0ea5e9;"></i> Order</th>
                                            <th><i class="fa-solid fa-circle-check" style="color: #10b981;"></i> Delivery</th>
                                            <th><i class="fa-solid fa-circle-xmark" style="color: #ef4444;"></i> Cancel</th>
                                            <th>% Rate</th>
                                            <th><i class="fa-brands fa-whatsapp" style="color: #22c55e;"></i> WA</th>
                                        </tr>
                                    </thead>
                                    <tbody id="db-details-tbody">
                                        <tr class="empty-state">
                                            <td colspan="7">No records to show. Select a date range.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB: ANALYTICS -->
                <section id="tab-analytics" class="tab-content">
                    <header class="topbar" style="margin-bottom: 0.75rem;">
                        <div>
                            <h1 class="page-title text-primary" style="font-size: 1.5rem; margin-bottom: 2px;">Advanced Analytics</h1>
                            <p class="subtitle" style="font-size: 0.8rem;">Real-time scanning analytics and performance logs</p>
                        </div>
                    </header>

                    <div style="display: flex; flex-direction: column; gap: 1.25rem; height: 100%; overflow-y: auto; padding-right: 4px;" class="custom-scrollbar">
                        <!-- Top Mini Stat Cards -->
                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
                            <div class="card" style="padding: 1rem; display: flex; align-items: center; gap: 12px; background: rgba(3, 7, 18, 0.4);">
                                <div class="stat-widget-icon" style="background: rgba(6, 182, 212, 0.15); color: #06b6d4; font-size: 1.2rem;">
                                    <i class="fa-solid fa-bolt"></i>
                                </div>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Scan Velocity</span>
                                    <span style="font-size: 1.1rem; font-weight: 700; color: #fff;">142.5 / min</span>
                                </div>
                            </div>
                            <div class="card" style="padding: 1rem; display: flex; align-items: center; gap: 12px; background: rgba(3, 7, 18, 0.4);">
                                <div class="stat-widget-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 1.2rem;">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </div>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Accuracy Rate</span>
                                    <span style="font-size: 1.1rem; font-weight: 700; color: #fff;">99.82%</span>
                                </div>
                            </div>
                            <div class="card" style="padding: 1rem; display: flex; align-items: center; gap: 12px; background: rgba(3, 7, 18, 0.4);">
                                <div class="stat-widget-icon" style="background: rgba(168, 85, 247, 0.15); color: #a855f7; font-size: 1.2rem;">
                                    <i class="fa-solid fa-server"></i>
                                </div>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Engine Load</span>
                                    <span style="font-size: 1.1rem; font-weight: 700; color: #fff;">18.4%</span>
                                </div>
                            </div>
                            <div class="card" style="padding: 1rem; display: flex; align-items: center; gap: 12px; background: rgba(3, 7, 18, 0.4);">
                                <div class="stat-widget-icon" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; font-size: 1.2rem;">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Fraud Detected</span>
                                    <span style="font-size: 1.1rem; font-weight: 700; color: #fff;">8.42%</span>
                                </div>
                            </div>
                        </div>

                        <!-- Graphical Mock Content -->
                        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 1.25rem;">
                            <!-- Performance Chart Card -->
                            <div class="card" style="padding: 1.25rem; display: flex; flex-direction: column; min-height: 250px;">
                                <div class="card-header" style="margin-bottom: 1rem; padding-bottom: 0.5rem; justify-content: flex-start; gap: 8px;">
                                    <i class="fa-solid fa-chart-area text-primary"></i>
                                    <h3>System Throughput History</h3>
                                </div>
                                <div style="flex: 1; display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; padding: 1rem 0.5rem; background: rgba(0,0,0,0.2); border-radius: 0.5rem; border: 1px solid var(--border-color); height: 180px;">
                                    <!-- Simple Pure CSS bar chart columns with glows -->
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1;">
                                        <div style="width: 100%; height: 35px; background: linear-gradient(to top, rgba(6,182,212,0.1), #06b6d4); border-radius: 4px; box-shadow: 0 0 10px rgba(6,182,212,0.3);"></div>
                                        <span style="font-size: 0.6rem; color: var(--text-muted);">09:00</span>
                                    </div>
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1;">
                                        <div style="width: 100%; height: 65px; background: linear-gradient(to top, rgba(6,182,212,0.1), #06b6d4); border-radius: 4px; box-shadow: 0 0 10px rgba(6,182,212,0.3);"></div>
                                        <span style="font-size: 0.6rem; color: var(--text-muted);">10:00</span>
                                    </div>
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1;">
                                        <div style="width: 100%; height: 120px; background: linear-gradient(to top, rgba(6,182,212,0.1), #06b6d4); border-radius: 4px; box-shadow: 0 0 10px rgba(6,182,212,0.3);"></div>
                                        <span style="font-size: 0.6rem; color: var(--text-muted);">11:00</span>
                                    </div>
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1;">
                                        <div style="width: 100%; height: 90px; background: linear-gradient(to top, rgba(6,182,212,0.1), #06b6d4); border-radius: 4px; box-shadow: 0 0 10px rgba(6,182,212,0.3);"></div>
                                        <span style="font-size: 0.6rem; color: var(--text-muted);">12:00</span>
                                    </div>
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1;">
                                        <div style="width: 100%; height: 145px; background: linear-gradient(to top, rgba(6,182,212,0.1), #06b6d4); border-radius: 4px; box-shadow: 0 0 10px rgba(6,182,212,0.3);"></div>
                                        <span style="font-size: 0.6rem; color: var(--text-muted);">13:00</span>
                                    </div>
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1;">
                                        <div style="width: 100%; height: 110px; background: linear-gradient(to top, rgba(6,182,212,0.1), #06b6d4); border-radius: 4px; box-shadow: 0 0 10px rgba(6,182,212,0.3);"></div>
                                        <span style="font-size: 0.6rem; color: var(--text-muted);">14:00</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Network Operator Breakdown Card -->
                            <div class="card" style="padding: 1.25rem; display: flex; flex-direction: column; min-height: 250px;">
                                <div class="card-header" style="margin-bottom: 1rem; padding-bottom: 0.5rem; justify-content: flex-start; gap: 8px;">
                                    <i class="fa-solid fa-tower-broadcast text-primary"></i>
                                    <h3>Operator Distribution</h3>
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 12px; flex: 1; justify-content: center;">
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
                                            <span style="font-weight: 600; color: #fff;">Grameenphone (GP)</span>
                                            <span style="color: var(--text-muted);">45%</span>
                                        </div>
                                        <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden;">
                                            <div style="width: 45%; height: 100%; background: #06b6d4; box-shadow: 0 0 8px #06b6d4;"></div>
                                        </div>
                                    </div>
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
                                            <span style="font-weight: 600; color: #fff;">Robi Axiata</span>
                                            <span style="color: var(--text-muted);">30%</span>
                                        </div>
                                        <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden;">
                                            <div style="width: 30%; height: 100%; background: #a855f7; box-shadow: 0 0 8px #a855f7;"></div>
                                        </div>
                                    </div>
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
                                            <span style="font-weight: 600; color: #fff;">Banglalink</span>
                                            <span style="color: var(--text-muted);">25%</span>
                                        </div>
                                        <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden;">
                                            <div style="width: 25%; height: 100%; background: #ef4444; box-shadow: 0 0 8px #ef4444;"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB: SETTINGS -->
                <section id="tab-settings" class="tab-content">
                    <header class="topbar">
                        <div>
                            <h1 class="page-title text-primary">System Settings</h1>
                            <p class="subtitle">Manage integrations and platform preferences</p>
                        </div>
                    </header>

                    <div class="settings-container">
                        <!-- Section: Integrations -->
                        <div class="settings-section-title">
                            <h3><i class="fa-solid fa-link text-primary"></i> System Integrations</h3>
                        </div>
                        <div class="integrations-row">
                            <!-- WhatsApp Checker -->
                            <div class="card settings-card whatsapp-card">
                                <div class="card-header">
                                    <i class="fa-brands fa-whatsapp text-success text-xl"></i>
                                    <h3>WhatsApp Checker</h3>
                                </div>
                                
                                <div class="setting-item-content">
                                    <div class="setting-item-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                                        <div class="setting-info">
                                            <h4>Enable Service</h4>
                                            <p>Verify WA accounts using QR Session.</p>
                                        </div>
                                        <label class="toggle-switch">
                                            <input type="checkbox" checked disabled>
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                    
                                    <div class="wa-status-container mt-3 mb-3">
                                        <div id="wa-status" class="wa-status pending" style="padding: 0.5rem; background: rgba(0,0,0,0.5); border-radius: 0.5rem; color: #fff; text-align: center;">
                                            <i class="fa-solid fa-circle-notch fa-spin"></i> Initializing...
                                        </div>
                                        <canvas id="qrcode-canvas" style="display: none; width: 100%; max-width: 200px; margin: 10px auto; border-radius: 8px;"></canvas>
                                    </div>
                                    
                                    <button id="disconnect-wa-btn" class="btn btn-secondary w-100">
                                        <i class="fa-solid fa-plug-circle-xmark"></i> Disconnect WhatsApp Session
                                    </button>
                                </div>
                            </div>

                            <!-- IMO Checker -->
                            <div class="card settings-card imo-card">
                                <div class="card-header">
                                    <i class="fa-solid fa-comments text-primary text-xl"></i>
                                    <h3>IMO Checker</h3>
                                </div>
                                
                                <div class="setting-item-content">
                                    <div class="setting-item-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                                        <div class="setting-info">
                                            <h4>Enable Service <span class="badge text-muted" style="font-size:0.65rem; background:rgba(255,255,255,0.05); padding:2px 6px; border-radius:4px; margin-left:5px;">Coming soon</span></h4>
                                            <p>Check numbers for active IMO accounts.</p>
                                        </div>
                                        <label class="toggle-switch">
                                            <input type="checkbox">
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                    <div style="padding: 2rem; text-align: center; color: var(--text-muted); background: rgba(0,0,0,0.2); border-radius: 0.5rem; border: 1px dashed var(--border-color); margin-top: 1rem;">
                                        <i class="fa-solid fa-lock" style="font-size: 1.5rem; opacity: 0.3; margin-bottom: 0.5rem; display: block;"></i>
                                        <span style="font-size: 0.85rem;">IMO scraping engine will be available in the next version.</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section: Preferences -->
                        <div class="settings-section-title mt-4">
                            <h3><i class="fa-solid fa-sliders text-primary"></i> App Preferences</h3>
                        </div>
                        <div class="preferences-row">
                            <!-- Audio Notifications Card -->
                            <div class="card settings-card audio-card">
                                <div class="card-header">
                                    <i class="fa-solid fa-volume-high text-primary text-xl"></i>
                                    <h3>Audio Notifications</h3>
                                </div>
                                <div class="setting-item-content">
                                    <div class="setting-item-header" style="display:flex; justify-content:space-between; align-items:center;">
                                        <div class="setting-info">
                                            <h4>Play Sound Alert</h4>
                                            <p>Play a sound when scanning is finished.</p>
                                        </div>
                                        <label class="toggle-switch">
                                            <input type="checkbox" id="audio-toggle" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Language Card -->
                            <div class="card settings-card language-card">
